# The Color of Love — Variables de entorno para Railway

# Puerto (Railway lo asigna automaticamente, pero se puede override)
PORT=5000

# Modo produccion
NODE_ENV=production

# API Key de Anthropic Claude (Jaime + Sombras + Huella diagnostico)
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXX

# Alternativa: usar el proxy de Perplexity (para Vercel)
# LLM_API_KEY=your-key-here

# Base de datos SQLite (Railway monta un volumen persistente)
DATABASE_URL=/data/tcl.db

# Timezone default (para usuarios sin perfil)
TZ=America/Mexico_City
